<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.0</Version>
    <Company>uwap.org</Company>
    <PackageProjectUrl>https://uwap.org/projects/tinytui</PackageProjectUrl>
    <Description>Cross-platform .NET library written in C# that allows you to create simple terminal user interfaces.</Description>
    <PackageIcon>u-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/pmpwsk/TinyTUI</RepositoryUrl>
    <PackageReleaseNotes>https://uwap.org/changes/tinytui</PackageReleaseNotes>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageId>Useful.TinyTUI</PackageId>
    <Title>TinyTUI</Title>
    <Copyright>uwap.org</Copyright>
    <Authors>pmpwsk</Authors>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Update="LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="u-128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
